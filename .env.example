# Variables d'environnement à définir (en local ou sur l'hébergeur, ex. Render).

# Clé de signature des sessions Flask
# Générer une valeur avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi

# Identifiants de l'espace d'administration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi

# Base de données (facultatif : SQLite en local par défaut)
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/sondage
